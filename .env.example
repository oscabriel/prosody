# Prosody's settings. Copy this file to `.env`, which git ignores, and fill it in.
# `pnpm run deploy` reads it from the repository's root.

# --- The host ---

# The library: the folder that holds `ebooks/` and `audiobooks/`, each with a folder for every
# author and, inside it, one for every title. The press mounts it writable and only ever adds files.
PROSODY_LIBRARY=/mnt/media/books

# Where fetched books land, as this host sees it. The press mounts it read-only.
PROSODY_DOWNLOADS=/mnt/media/downloads/books

# The reading copies, on a local disk. Make the folder once, owned by the user below.
# PROSODY_COPIES=/srv/prosody/copies

# The user the press runs as: whoever owns the library and the reading copies (`id -u`).
# PROSODY_UID=1000

# Where the relay listens. Keep it on a loopback address: Caddy is the only way in.
# PROSODY_RELAY=127.0.0.1:3023

# --- The desk's fetching (optional) ---

# What the desk fetches books through: docs/acquiring/README.md explains each setting.
# They must be set even if you fetch nothing; any placeholder will do.
INDEXER_URL=http://indexer.lan:9696
INDEXER_API_KEY=
DOWNLOADS_URL=http://downloads.lan:8080
DOWNLOADS_USERNAME=
DOWNLOADS_PASSWORD=
# DOWNLOADS_CATEGORY=books
