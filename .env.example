# Host settings for Prosody.
# Copy this file to `.env` at the repository root (git ignores it) and fill in your values.
# Read by `pnpm run deploy`, `pnpm run plan`, and the Vite dev/build configs.

# --- Host paths and networking ---

# Required. Root directory of your book library on the host.
# Must contain `ebooks/<Author>/<Title>/` and `audiobooks/<Author>/<Title>/`.
# Mounted writable into the press, which only adds newly shelved files.
PROSODY_LIBRARY=/mnt/media/books

# Optional (default: /srv/prosody/copies). Local directory where the press writes reading copies.
# Create this directory once on the host and make it writable by PROSODY_UID.
# PROSODY_COPIES=/srv/prosody/copies

# Optional (default: 1000). Numeric user ID (`id -u`) that the press runs as.
# Must have write access to PROSODY_LIBRARY and PROSODY_COPIES.
# PROSODY_UID=1000

# Optional (default: 127.0.0.1:3023). Address and port where the relay listens on the host.
# Keep this bound to loopback so Caddy is the only way in.
# Also used by `packages/web` in dev mode to proxy `/api`, `/auth` and `/copies`.
# PROSODY_RELAY=127.0.0.1:3023

# --- Sign-in and accounts ---

# Optional (default: unset, derived from X-Forwarded-Proto and Host).
# Canonical public origin of Prosody, with no trailing slash. Recommended in production
# so OIDC callback URLs and Secure cookies do not depend on proxy headers.
# PROSODY_PUBLIC_URL=https://prosody.example.com

# Optional (default: true). Set to `false` to disable local password sign-in, first-run
# setup and invite registration (use only when OIDC is configured).
# PROSODY_LOCAL_AUTH=true

# Optional. OpenID Connect issuer URL (with no trailing slash) to enable single sign-on.
# Both OIDC_ISSUER_URL and OIDC_CLIENT_ID must be set to enable OIDC sign-in.
# OIDC_ISSUER_URL=https://id.example.com

# Optional (default: unset). Alternate origin for backchannel discovery, JWKS, token and
# userinfo requests from inside the Api container (for example on split-horizon DNS).
# Browser redirects and token issuer checks still use OIDC_ISSUER_URL.
# OIDC_INTERNAL_URL=

# Optional. Client ID registered with your OIDC provider.
# Redirect URI: <PROSODY_PUBLIC_URL>/auth/oidc/callback
# OIDC_CLIENT_ID=

# Optional. Client secret for confidential OIDC clients. Leave unset for public PKCE clients.
# OIDC_CLIENT_SECRET=

# Optional (default: Single sign-on). Label shown on the OIDC sign-in button.
# OIDC_DISPLAY_NAME=Single sign-on

# Optional (default: admins). Group name in the OIDC `groups` claim that grants the admin role.
# OIDC_ADMIN_GROUP=admins

# Optional (default: openid profile email groups). Space-separated OIDC scopes to request.
# OIDC_SCOPES=openid profile email groups

# --- Fetching from the desk (optional) ---

# Leave all of these unset to use Prosody purely with your existing library.
# Set them to let the desk search and fetch books; see docs/acquiring/README.md for details.
# INDEXER_URL=http://indexer.lan:9696
# INDEXER_API_KEY=
# DOWNLOADS_URL=http://downloads.lan:8080
# DOWNLOADS_USERNAME=
# DOWNLOADS_PASSWORD=
# DOWNLOADS_CATEGORY=books

# Optional (default: unset). Host path where fetched book files arrive.
# Mounted read-only into the press so it can copy finished files into PROSODY_LIBRARY.
# PROSODY_DOWNLOADS=/mnt/media/downloads/books

# --- Public site (only when building or deploying packages/site) ---

# Optional (default: unset). Custom domain for the Cloudflare site and its prerender origin.
# Leave unset to deploy to a workers.dev address (prerendering falls back to prosody.example.com).
# PROSODY_SITE_DOMAIN=prosody.example.com
