{
	"format_on_save": "on",
	"formatter": "language_server",
	"hard_tabs": true,
	"tab_size": 2,
	"lsp": {
		"vtsls": {
			"settings": {
				"javascript": {
					"preferences": {
						"includePackageJsonAutoImports": "on"
					}
				},
				"typescript": {
					"preferences": {
						"includePackageJsonAutoImports": "on"
					}
				}
			}
		},
		"oxfmt": {
			"initialization_options": {
				"settings": {
					"configPath": null,
					"flags": {},
					"fmt.configPath": null,
					"fmt.experimental": true,
					"run": "onSave",
					"typeAware": false,
					"unusedDisableDirectives": false
				}
			}
		},
		"oxlint": {
			"initialization_options": {
				"settings": {
					"disableNestedConfig": false,
					"fixKind": "safe_fix",
					"run": "onType",
					"typeAware": null,
					"unusedDisableDirectives": "deny"
				}
			}
		}
	},
	"languages": {
		"CSS": {
			"formatter": {
				"language_server": {
					"name": "oxfmt"
				}
			}
		},
		"HTML": {
			"formatter": {
				"language_server": {
					"name": "oxfmt"
				}
			}
		},
		"JSON": {
			"formatter": {
				"language_server": {
					"name": "oxfmt"
				}
			}
		},
		"JSONC": {
			"formatter": {
				"language_server": {
					"name": "oxfmt"
				}
			}
		},
		"JavaScript": {
			"code_actions_on_format": {
				"source.fixAll.oxc": true
			},
			"formatter": {
				"language_server": {
					"name": "oxfmt"
				}
			}
		},
		"Markdown": {
			"format_on_save": "off"
		},
		"TSX": {
			"code_actions_on_format": {
				"source.fixAll.oxc": true
			},
			"formatter": {
				"language_server": {
					"name": "oxfmt"
				}
			}
		},
		"TypeScript": {
			"code_actions_on_format": {
				"source.fixAll.oxc": true
			},
			"formatter": {
				"language_server": {
					"name": "oxfmt"
				}
			}
		},
		"YAML": {
			"formatter": {
				"language_server": {
					"name": "oxfmt"
				}
			}
		}
	}
}
