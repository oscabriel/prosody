{
	"name": "prosody",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "effect-tsgo patch --oxlint",
		"fmt": "oxfmt",
		"lint": "oxlint",
		"fix": "oxlint --fix && oxfmt",
		"typecheck": "tsc --noEmit && pnpm -r typecheck",
		"test": "vitest run --passWithNoTests",
		"check": "oxfmt --check && oxlint && pnpm typecheck && pnpm test"
	},
	"devDependencies": {
		"@effect/tsgo": "catalog:",
		"@oxlint/plugins": "catalog:",
		"@types/node": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:",
		"ultracite": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=26.11.0"
	},
	"packageManager": "pnpm@10.30.3"
}
