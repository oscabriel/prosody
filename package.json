{
	"name": "prosody",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "effect-tsgo patch --oxlint --tsrs",
		"fmt": "oxfmt",
		"lint": "oxlint",
		"fix": "oxlint --fix && oxfmt",
		"typecheck": "tsc --noEmit && pnpm -r typecheck",
		"test": "vitest run --passWithNoTests",
		"check": "oxfmt --check && oxlint && pnpm typecheck && pnpm test",
		"plan": "bunx --bun alchemy plan",
		"deploy": "bunx --bun alchemy deploy",
		"destroy": "bunx --bun alchemy destroy"
	},
	"dependencies": {
		"@alchemy.run/docker": "catalog:",
		"@alchemy.run/effect-cluster": "catalog:",
		"@effect/platform-bun": "catalog:",
		"@prosody/press": "workspace:*",
		"@prosody/server": "workspace:*",
		"alchemy": "catalog:",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@effect/tsgo": "catalog:",
		"@oxlint/plugins": "catalog:",
		"@types/node": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"tsrs": "catalog:",
		"typescript": "catalog:",
		"ultracite": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=26.11.0"
	},
	"packageManager": "pnpm@12.21.0"
}
