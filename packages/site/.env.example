# Dev-server settings for `pnpm --filter @prosody/site dev`.
# Copy to `packages/site/.env` (git ignores it).

# Optional. Private hostname that Caddy proxies to this dev server (127.0.0.1:3034).
# Setting this allows the host in Vite and routes HMR over wss on port 443.
# Leave unset to open the dev server directly at http://127.0.0.1:3034.
# CADDY_DEV_HOST=prosody-site.example.com
