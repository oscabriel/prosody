# Dev-server settings for `pnpm --filter @prosody/web dev`.
# Copy to `packages/web/.env` (git ignores it).

# Optional. Private hostname that Caddy proxies to this dev server (127.0.0.1:3022).
# Setting this allows the host in Vite and routes HMR over wss on port 443.
# Leave unset to open the dev server directly at http://127.0.0.1:3022.
# CADDY_DEV_HOST=prosody-dev.example.com
